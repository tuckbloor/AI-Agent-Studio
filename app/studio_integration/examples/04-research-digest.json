{
  "format": "agent-studio/workflow",
  "version": 1,
  "id": "example-04-research-digest",
  "name": "Research digest",
  "steps": [
    {
      "id": "start",
      "type": "trigger",
      "title": "Start",
      "description": "Enter a question or paste text",
      "config": {
        "event": "manual"
      }
    },
    {
      "id": "tools",
      "type": "mcp",
      "title": "Use selected tools",
      "description": "Tools run in the listed order",
      "config": {
        "tools": [
          "builtin:extract_urls",
          "builtin:extract_dates",
          "builtin:unique_lines"
        ],
        "toolArgs": {}
      }
    },
    {
      "id": "ollama",
      "type": "ai",
      "title": "Think with Ollama",
      "description": "Analyse tool results",
      "config": {
        "model": "",
        "instructions": "Summarise pasted research notes. Do not claim to have visited URLs."
      }
    },
    {
      "id": "output",
      "type": "output",
      "title": "Return the answer",
      "description": "Show result",
      "config": {
        "format": "text"
      }
    }
  ]
}
